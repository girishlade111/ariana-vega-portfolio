---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  tag: string;
  href: string;
  image: ImageMetadata;
  alt: string;
  index: number;
}

const { title, tag, href, image, alt, index } = Astro.props;
---

<a 
  href={href} 
  class="project-card" 
  aria-label={`View ${title} case study`}
  data-reveal
  style={`--i: ${index};`}
>
  <div class="card-cover-wrapper">
    <Image 
      src={image} 
      alt={alt} 
      width={1200} 
      height={1000} 
      loading="lazy"
      class="card-cover-img"
    />
  </div>
  <div class="card-info-bar">
    <div class="card-info-left">
      <h3 class="card-title">{title}</h3>
      <span class="card-tag-chip">{tag}</span>
    </div>
    <div class="card-action-circle" aria-hidden="true">
      <Icon name="arrow-up-right" size={16} color="var(--coral-500)" class="action-arrow" />
    </div>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--plum-800);
    border: 1px solid rgba(245, 133, 90, 0.15);
    border-radius: var(--r-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.38);
    border-color: rgba(240, 80, 90, 0.35);
  }

  .card-cover-wrapper {
    width: 100%;
    aspect-ratio: 220 / 183;
    overflow: hidden;
    position: relative;
    background: var(--plum-900);
  }

  .card-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .card-cover-img {
    transform: scale(1.05);
  }

  .card-info-bar {
    padding: 14px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    background: var(--plum-800);
  }

  .card-info-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
  }

  .card-title {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.1vw, 17px);
    font-weight: 600;
    color: var(--cream-100);
    margin: 0;
    line-height: 1.2;
  }

  .card-tag-chip {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--cream-muted);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 4px 10px;
    line-height: 1;
    white-space: nowrap;
  }

  .card-action-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--coral-500);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  :global(.action-arrow) {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), stroke 0.3s ease;
  }

  .project-card:hover .card-action-circle {
    background: var(--grad-btn);
    border-color: transparent;
  }

  .project-card:hover :global(.action-arrow) {
    stroke: #FFF;
    transform: translate(2px, -2px);
  }
</style>
