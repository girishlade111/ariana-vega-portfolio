---
interface Props {
  name: 
    | 'arrow-up-right' 
    | 'sun-center' 
    | 'starburst-center'
    | 'uiux' 
    | 'web' 
    | 'mobile' 
    | 'visual' 
    | 'interaction' 
    | 'layers' 
    | 'heart' 
    | 'globe' 
    | 'mail' 
    | 'instagram' 
    | 'map-pin'
    | 'quote-mark'
    | 'hand-arrow';
  size?: number | string;
  class?: string;
  color?: string;
}

const { 
  name, 
  size = 24, 
  class: className = '',
  color = 'currentColor'
} = Astro.props;

const pixelSize = typeof size === 'number' ? `${size}px` : size;
---

{name === 'arrow-up-right' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke={color} 
    stroke-width="2" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={className}
    aria-hidden="true"
  >
    <line x1="7" y1="17" x2="17" y2="7" />
    <polyline points="7 7 17 7 17 17" />
  </svg>
)}

{name === 'sun-center' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke={color} 
    stroke-width="1.8" 
    stroke-linecap="round" 
    class={className}
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.5" fill={color} />
    <line x1="12" y1="2" x2="12" y2="4.5" />
    <line x1="12" y1="19.5" x2="12" y2="22" />
    <line x1="2" y1="12" x2="4.5" y2="12" />
    <line x1="19.5" y1="12" x2="22" y2="12" />
    <line x1="4.93" y1="4.93" x2="6.7" y2="6.7" />
    <line x1="17.3" y1="17.3" x2="19.07" y2="19.07" />
    <line x1="4.93" y1="19.07" x2="6.7" y2="17.3" />
    <line x1="17.3" y1="6.7" x2="19.07" y2="4.93" />
  </svg>
)}

{name === 'starburst-center' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke={color} 
    stroke-width="1.8" 
    stroke-linecap="round" 
    class={className}
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="3.5" fill={color} />
    <line x1="12" y1="1.5" x2="12" y2="5" />
    <line x1="12" y1="19" x2="12" y2="22.5" />
    <line x1="1.5" y1="12" x2="5" y2="12" />
    <line x1="19" y1="12" x2="22.5" y2="12" />
    <line x1="4.5" y1="4.5" x2="7" y2="7" stroke-width="1.4" />
    <line x1="17" y1="17" x2="19.5" y2="19.5" stroke-width="1.4" />
    <line x1="4.5" y1="19.5" x2="7" y2="17" stroke-width="1.4" />
    <line x1="17" y1="7" x2="19.5" y2="4.5" stroke-width="1.4" />
  </svg>
)}

{name === 'uiux' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 48 48" 
    fill="none" 
    stroke={color} 
    stroke-width="1.6" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={className}
    aria-hidden="true"
  >
    <!-- Bezier curve with square anchor handles -->
    <path d="M8 38 C 12 12, 36 12, 40 38" />
    <rect x="5" y="35" width="6" height="6" fill="#331839" stroke={color} stroke-width="1.6" />
    <rect x="37" y="35" width="6" height="6" fill="#331839" stroke={color} stroke-width="1.6" />
    <circle cx="24" cy="16" r="3" stroke={color} stroke-width="1.5" />
    <!-- Pen tool nib in center -->
    <path d="M24 19 L21 27 L24 33 L27 27 Z" />
    <line x1="24" y1="27" x2="24" y2="33" />
  </svg>
)}

{name === 'web' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 48 48" 
    fill="none" 
    stroke={color} 
    stroke-width="1.6" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={className}
    aria-hidden="true"
  >
    <!-- Monitor outline -->
    <rect x="6" y="8" width="36" height="26" rx="3" />
    <line x1="18" y1="34" x2="16" y2="40" />
    <line x1="30" y1="34" x2="32" y2="40" />
    <line x1="14" y1="40" x2="34" y2="40" />
    <!-- Wireframe content: header bar and blocks -->
    <line x1="10" y1="14" x2="38" y2="14" stroke-dasharray="2 2" />
    <rect x="10" y="18" width="12" height="11" rx="1.5" stroke-width="1.2" />
    <line x1="26" y1="18" x2="38" y2="18" stroke-width="1.4" />
    <line x1="26" y1="22" x2="35" y2="22" stroke-width="1.2" />
    <line x1="26" y1="26" x2="32" y2="26" stroke-width="1.2" />
  </svg>
)}

{name === 'mobile' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 48 48" 
    fill="none" 
    stroke={color} 
    stroke-width="1.6" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={className}
    aria-hidden="true"
  >
    <!-- Phone outline -->
    <rect x="14" y="6" width="20" height="36" rx="4" />
    <!-- Speaker slit -->
    <line x1="21" y1="10" x2="27" y2="10" stroke-width="1.4" />
    <!-- Screen area -->
    <rect x="17" y="14" width="14" height="21" rx="1" fill="#F0505A" fill-opacity="0.15" stroke-width="1.2" />
    <!-- Home button / indicator circle -->
    <circle cx="24" cy="38" r="1.5" fill={color} />
  </svg>
)}

{name === 'visual' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 48 48" 
    fill="none" 
    stroke={color} 
    stroke-width="1.6" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={className}
    aria-hidden="true"
  >
    <!-- Eye with iris + small sparkle -->
    <path d="M6 24 C 13 14, 35 14, 42 24 C 35 34, 13 34, 6 24 Z" />
    <circle cx="24" cy="24" r="6" />
    <circle cx="24" cy="24" r="2.5" fill={color} />
    <!-- Sparkle near eye corner -->
    <path d="M37 13 L38 10 L39 13 L42 14 L39 15 L38 18 L37 15 L34 14 Z" fill={color} stroke="none" />
  </svg>
)}

{name === 'interaction' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 48 48" 
    fill="none" 
    stroke={color} 
    stroke-width="1.6" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={className}
    aria-hidden="true"
  >
    <!-- Rocket tilted 45 degrees -->
    <path d="M29 8 C 36 9, 39 14, 39 19 C 39 25, 33 30, 27 33 L 23 29 L 29 23 L 25 19 L 19 25 L 15 21 C 18 15, 23 9, 29 8 Z" />
    <!-- Fins -->
    <path d="M19 25 L 12 28 L 15 21" />
    <path d="M29 35 L 26 42 L 33 39" />
    <circle cx="30" cy="18" r="2.5" fill={color} stroke="none" />
    <!-- Flame trail & stars -->
    <path d="M17 31 C 14 34, 12 39, 10 41 C 12 39, 17 37, 20 34" stroke-width="1.4" />
    <circle cx="9" cy="17" r="1.2" fill={color} stroke="none" />
    <circle cx="41" cy="31" r="1.2" fill={color} stroke="none" />
  </svg>
)}

{name === 'layers' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke={color} 
    stroke-width="1.8" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={className}
    aria-hidden="true"
  >
    <polygon points="12 2 2 7 12 12 22 7 12 2" />
    <polyline points="2 12 12 17 22 12" />
    <polyline points="2 17 12 22 22 17" />
  </svg>
)}

{name === 'heart' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke={color} 
    stroke-width="1.8" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={className}
    aria-hidden="true"
  >
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
  </svg>
)}

{name === 'globe' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke={color} 
    stroke-width="1.8" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={className}
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="10" />
    <line x1="2" y1="12" x2="22" y2="12" />
    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
  </svg>
)}

{name === 'mail' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke={color} 
    stroke-width="1.8" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={className}
    aria-hidden="true"
  >
    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
    <polyline points="22,6 12,13 2,6" />
  </svg>
)}

{name === 'instagram' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke={color} 
    stroke-width="1.8" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={className}
    aria-hidden="true"
  >
    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
  </svg>
)}

{name === 'map-pin' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke={color} 
    stroke-width="1.8" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class={className}
    aria-hidden="true"
  >
    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
    <circle cx="12" cy="10" r="3" />
  </svg>
)}

{name === 'quote-mark' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 40 40" 
    fill={color} 
    class={className}
    aria-hidden="true"
  >
    <path d="M10 24 C 10 16, 14 10, 20 8 L 22 11 C 18 13, 16 16, 16 18 L 20 18 C 22.2 18, 24 19.8, 24 22 L 24 28 C 24 30.2, 22.2 32, 20 32 L 14 32 C 11.8 32, 10 30.2, 10 28 Z M 26 24 C 26 16, 30 10, 36 8 L 38 11 C 34 13, 32 16, 32 18 L 36 18 C 38.2 18, 40 19.8, 40 22 L 40 28 C 40 30.2, 38.2 32, 36 32 L 30 32 C 27.8 32, 26 30.2, 26 28 Z" />
  </svg>
)}

{name === 'hand-arrow' && (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={pixelSize} 
    height={pixelSize} 
    viewBox="0 0 60 20" 
    fill="none" 
    stroke={color} 
    stroke-width="1.8" 
    stroke-linecap="round" 
    class={className}
    aria-hidden="true"
  >
    <path d="M4 14 C 18 10, 36 15, 52 8" />
    <path d="M45 4 L 54 8 L 47 13" />
  </svg>
)}
