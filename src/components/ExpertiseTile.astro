---
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  icon: 'uiux' | 'web' | 'mobile' | 'visual' | 'interaction';
  index: number;
}

const { title, description, icon, index } = Astro.props;
---

<div class="expertise-tile" data-reveal style={`--i: ${index};`}>
  <div class="tile-icon-wrapper">
    <Icon name={icon} size="clamp(36px, 3.2vw, 48px)" color="#F26B4E" />
  </div>
  <h3 class="tile-title">{title}</h3>
  <p class="tile-desc">{description}</p>
</div>

<style>
  .expertise-tile {
    background: var(--plum-800);
    border: 1px solid rgba(245, 133, 90, 0.12);
    border-radius: var(--r-md);
    padding: clamp(16px, 1.8vw, 24px) 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .expertise-tile:hover {
    transform: translateY(-4px);
    border-color: var(--coral-500);
    box-shadow: 0 0 24px rgba(240, 80, 90, 0.28);
  }

  .tile-icon-wrapper {
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 52px;
  }

  .tile-title {
    font-family: var(--font-sans);
    font-size: clamp(14px, 1vw, 16px);
    font-weight: 600;
    color: var(--orange-400);
    margin: 0 0 8px 0;
    line-height: 1.25;
  }

  .tile-desc {
    font-family: var(--font-sans);
    font-size: clamp(12px, 0.85vw, 13px);
    font-weight: 400;
    color: var(--cream-muted);
    line-height: 1.45;
    margin: 0;
    max-width: 17ch;
  }
</style>
