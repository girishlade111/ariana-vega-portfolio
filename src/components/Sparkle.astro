---
interface Props {
  size?: number;
  color?: string;
  class?: string;
}

const { 
  size = 14, 
  color = 'var(--orange-400)', 
  class: className = '' 
} = Astro.props;
---

<svg 
  xmlns="http://www.w3.org/2000/svg" 
  width={size} 
  height={size} 
  viewBox="0 0 24 24" 
  fill={color} 
  class={`sparkle-svg ${className}`}
  aria-hidden="true"
>
  <path d="M12 0 C 12 7, 17 12, 24 12 C 17 12, 12 17, 12 24 C 12 17, 7 12, 0 12 C 7 12, 12 7, 12 0 Z" />
</svg>

<style>
  .sparkle-svg {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }
</style>
